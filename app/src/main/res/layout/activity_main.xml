<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF7F5F2"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="息屏听剧"
            android:textColor="#FF1B1B1B"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="3dp"
            android:text="在任意视频App里点悬浮球：屏幕变黑、声音继续、触摸被屏蔽。\n本App完全不联网、不收集任何数据。"
            android:textColor="#FF666666"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_overlay_perm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp" />

        <Button
            android:id="@+id/btn_battery_perm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp" />

        <Button
            android:id="@+id/btn_notify_perm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp" />

        <Button
            android:id="@+id/btn_a11y_perm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp" />

        <Button
            android:id="@+id/btn_start"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="#FF1B7A4B"
            android:text="启动悬浮球"
            android:textColor="#FFFFFFFF"
            android:textSize="17sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="#FFFFFFFF"
            android:lineSpacingExtra="4dp"
            android:padding="16dp"
            android:text="两种听法\n【真息屏续播 · 推荐】看剧时直接按电源键熄屏，1~2秒后声音自动恢复，屏幕全关最省电\n【黑屏遮罩】点悬浮球 → 屏幕变黑声音继续，双击任意处恢复\n\n如果真息屏后声音没回来：\n· 该App不支持媒体键唤醒，改用黑屏遮罩\n· 或开它自带的「后台播放/音频模式」开关\n\n通知栏可切换「真息屏续播」开关和退出。\n被ColorOS清理？最近任务里下拉本App卡片加锁。"
            android:textColor="#FF444444"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
