<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      深色模式主题（跟随系统）；日间版在 values/themes.xml。
      父主题换用 Material **深色** → 系统级弹窗（AlertDialog/单选框/按钮/滚动条）
      自动全套变暗，不用逐个自定义。
    -->
    <style name="Theme.XiTing" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/bg_page</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/bg_page</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:colorPrimary">@color/brand</item>
        <item name="android:colorPrimaryDark">@color/brand_dark</item>
    </style>
</resources>
