<?xml version="1.0" encoding="utf-8"?>
<!--
  成就明细弹窗：每条成就左侧一枚徽章（已点亮=金色实心，未解锁=暗色轮廓），
  右侧标题 + 条件描述。行由 MainActivity.showAchievements() 动态填充。
  徽章画法与精灵身上那一列共用 Badges，两处完全一致。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="12dp">

    <TextView
        android:id="@+id/ach_dlg_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="#FF111418"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="@string/ach_dlg_hint"
        android:textColor="#FF8A9099"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/ach_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical" />
</LinearLayout>
