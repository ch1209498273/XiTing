<?xml version="1.0" encoding="utf-8"?>
<!--
  语义色板（深色模式改造，2026-10-10）。

  规则：
  1. 日间值在本文件，夜间值在 values-night/colors.xml（名字一一对应）。
  2. 新增界面颜色时**必须**同时补夜间的值，否则深色模式会拿日间色（多半刺眼/看不清）。
  3. 布局/绘制代码不要再写死色值，一律从这里取。
  4. 悬浮遮罩、小部件、海报等「自成一套配色」的表面不在此列（见各自文件的理由）。
-->
<resources>
    <color name="ic_launcher_background">#FF12213E</color>

    <!-- 表面 -->
    <color name="bg_page">#FFF7F8FA</color>
    <color name="bg_surface">#FFFFFFFF</color>
    <color name="bg_stats_root">#FFFFFFFF</color>

    <!-- 文本 -->
