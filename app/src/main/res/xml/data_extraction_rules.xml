<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+（API 31+）备份/换机规则。

  背景：本App 对外宣称「无 INTERNET 权限 · 所有数据仅保存在本机」（见
  res/values/strings.xml 的 about_privacy）。但只要不写规则，Android 就会把
  SharedPreferences（能量、连续天数、统计、皮肤解锁状态）连同 filesDir 下的
  sessions.json 一起上传到用户的 Google Drive 云备份——即使App 自己没有网络权限，
  上传动作由系统服务完成，App 拦不住。这与隐私声明直接矛盾，商店审核可检出。

  因此分两段处理，各取所需：

  · cloud-backup —— 全域排除。用户数据绝不离开设备云端，这是隐私承诺的落点。
  · device-transfer —— 不排除。保留换机直达迁移，用户换新手机时由系统
    点对点搬运（不经云端存储，不产生云备份副本），体验与数据连续性都保住。

  注意：device-transfer 段仅在 API 31+ 生效。Android 11 及以下无法区分
  云备份与换机迁移，其规则见 backup_rules.xml（本项目在那一档选择完全排除，
  换机请用应用内「导出/导入备份」功能）。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <!-- 故意留空：保留换机直达迁移（点对点，不入云） -->
    </device-transfer>
</data-extraction-rules>