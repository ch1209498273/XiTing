<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFFFF"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- 电能精灵 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:elevation="1dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="14dp">

            <com.lujinyu.xiting.PetView
                android:id="@+id/pet_view"
                android:layout_width="match_parent"
                android:layout_height="240dp" />

            <!-- 形态图鉴：5 个缩略图（已解锁亮色/未解锁灰暗），点击查看信息 -->
            <LinearLayout
                android:id="@+id/thumb_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/gallery_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="点击图鉴查看各形态"
                android:textColor="#FF8A9099"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/pet_caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="电能精灵 · 由你的真实听剧时长喂养"
                android:textColor="#FF5F6570"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/pet_share"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="?android:attr/selectableItemBackground"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="分享战绩 · 解锁精灵装扮 ›"
                android:textColor="#FF1E8E5A"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="息屏听剧的时长与省电估算（保存在本机）"
            android:textColor="#FF5F6570"
            android:textSize="13sp" />

        <!-- 三个汇总卡 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/card_today"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="今日"
                    android:textColor="#FF8A9099"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/sum_today"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="0分钟"
                    android:textColor="#FF111418"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/sum_today_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 次"
                    android:textColor="#FF5F6570"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/card_week"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="近7天"
                    android:textColor="#FF8A9099"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/sum_week"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="0分钟"
                    android:textColor="#FF111418"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/sum_week_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 次"
                    android:textColor="#FF5F6570"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/card_all"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_card_selected"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="累计"
                    android:textColor="#FF8A9099"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/sum_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="0分钟"
                    android:textColor="#FF157A4C"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/sum_all_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 次"
                    android:textColor="#FF5F6570"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 省电估算 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_row_battery" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/sum_mah"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="累计估算省电 ≈ 0 mAh"
                    android:textColor="#FF111418"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/sum_extra"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="最长单次 — · 共 0 次息屏"
                    android:textColor="#FF8A9099"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 近7天柱状图 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="近7天每日息屏时长"
                android:textColor="#FF111418"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.lujinyu.xiting.BarChartView
                android:id="@+id/bar_chart"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- 最近记录 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="最近会话记录 · 仅保留最近30天"
                android:textColor="#FF111418"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/session_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/pager_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/btn_prev"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:padding="10dp"
                    android:text="‹ 上一页"
                    android:textColor="#FF1E8E5A"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/pager_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="第 1 / 1 页"
                    android:textColor="#FF8A9099"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btn_next"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:padding="10dp"
                    android:text="下一页 ›"
                    android:textColor="#FF1E8E5A"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
